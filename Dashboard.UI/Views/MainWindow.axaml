<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dashboard.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
        x:Class="Dashboard.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Images/avalonia-logo.ico"
        Title="Dashboard.UI"
        Width="600"
        Height="450">

    <Grid RowDefinitions="Auto, *, Auto">

        <!--Title Bar-->
       <Grid Grid.Row="0" Height="40" Background="Orange" ColumnDefinitions="Auto, Auto, *, Auto, Auto">
            <Grid Width="150"  >
                <Grid Grid.Row="0" />
                <Label Grid.Row="1" >LUFS</Label>
            </Grid>
            <Rectangle Grid.Column="1" Fill="Blue" Width="40"  />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" >
                <Label FontWeight="Black">AVALONIA</Label>
                <Label>LOUDNESS METER</Label>
            </StackPanel>
            <Rectangle Grid.Column="3" Fill="Green" Width="40"  />
            <Rectangle Grid.Column="4" Fill="Yellow" Width="40"  />
        </Grid>

        <!--Main Area-->
        <Grid Grid.Row="1" ColumnDefinitions="Auto, Auto, *" Background="#1a1c20">
            <Grid Grid.Column="0" Width="150" RowDefinitions="*, Auto, Auto">
                <Grid Grid.Row="0" />
                <Label Grid.Row="1" Foreground="White" FontSize="20" HorizontalAlignment="Center" Margin="0,5">LUFS</Label>
                <StackPanel Grid.Row="2">
                        <Button>A</Button>
                        <Button>B</Button>
                </StackPanel>
            </Grid>
            <Rectangle Grid.Column="1" Fill="PaleGreen" Width="140"  />
            <Rectangle Grid.Column="2" Fill="PaleVioletRed"/>
        </Grid>

        <!--Bottom Bar-->
        <Grid Grid.Row="2" Margin="8" Background="Cyan" ColumnDefinitions="Auto, Auto, *, Auto, Auto, Auto, Auto, Auto">
            <Button Grid.Column="0" Margin="4">Stereo</Button>
            <Button Grid.Column="1">YouTube</Button>
            <Button Grid.Column="3" Margin="0,0,8,0">10 SEC</Button>
            <Button Grid.Column="4" Margin="0,0,8,0">CONTINUOUS</Button>
            <Rectangle Grid.Column="5" Fill="Orange" Width="30" Margin="0,0,8,0"></Rectangle>
            <Rectangle Grid.Column="6" Fill="Red" Width="30" Margin="0,0,8,0"></Rectangle>
        </Grid>

    </Grid>
</Window>